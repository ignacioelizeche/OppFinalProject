# AWS Cognito Configuration
# Copy this file to .env.local and fill in your AWS Cognito details

# AWS Region where your Cognito User Pool is located
NEXT_PUBLIC_AWS_REGION=us-east-1

# Cognito User Pool ID (found in AWS Console > Cognito > User Pools)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=your-user-pool-id

# Cognito User Pool Web Client ID (found in your User Pool > App clients)
NEXT_PUBLIC_COGNITO_USER_POOL_WEB_CLIENT_ID=your-web-client-id

# Cognito Identity Pool ID (optional, for AWS resource access)
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=your-identity-pool-id

# Custom domain for Cognito (optional)
NEXT_PUBLIC_COGNITO_CUSTOM_DOMAIN=your-custom-domain.auth.us-east-1.amazoncognito.com

# OAuth Configuration (if using social providers)
NEXT_PUBLIC_COGNITO_OAUTH_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:3000/dashboard
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3000/login

# Development mode flag
NEXT_PUBLIC_USE_AWS_COGNITO=false
